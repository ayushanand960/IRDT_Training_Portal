# Auto-normalize all text files to use LF on commit
* text=auto

# Specific line endings
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.swift text eol=lf
*.dart text eol=lf
*.bat text eol=crlf

# Binary files (no line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.ttf binary
*.woff binary
